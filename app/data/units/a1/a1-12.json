  "grammar": {
    "title": "avoir mal à + il faut + infinitive",
    "intro": "To say where it hurts, use avoir mal à + the body part (à + le = au, à + les = aux). To say what you must do, use il faut + infinitive: it never changes, whoever must do it.",
    "table": [
      [
        "",
        "Structure",
        "Example"
      ],
      [
        "pain (masc.)",
        "avoir mal au + noun",
        "J'ai mal au dos."
      ],
      [
        "pain (fem.)",
        "avoir mal à la + noun",
        "J'ai mal à la tête."
      ],
      [
        "pain (plural)",
        "avoir mal aux + noun",
        "J'ai mal aux dents."
      ],
      [
        "you must",
        "il faut + infinitive",
        "Il faut se reposer."
      ],
      [
        "you mustn't",
        "il ne faut pas + infinitive",
        "Il ne faut pas sortir."
      ]
    ],
    "examples": [
      {
        "fr": "J'ai mal au ventre.",
        "en": "I have a stomach ache."
      },
      {
        "fr": "Il faut boire beaucoup d'eau.",
        "en": "You need to drink a lot of water."
      },
      {
        "fr": "Il ne faut pas aller au travail.",
        "en": "You mustn't go to work."
      }
    ],
    "trap": "il faut is always « il »: « il faut partir » can mean I / you / we must leave. In the negative, ne… pas wraps faut: « il ne faut pas ». With a vowel: « à l'oreille »."
  },
  "sounds": {
    "title": "peu or peur?",
    "explain": "« eu » has two sounds: closed at the end of a word (peu, deux, bleu), open before a pronounced consonant (peur, sœur, fleur). Open = mouth a bit wider.",
    "pairs": [
      [
        "peu",
        "peur"
      ],
      [
        "ceux",
        "sœur"
      ],
      [
        "bleu",
        "fleur"
      ],
      [
        "deux",
        "neuf"
      ]
    ],
    "tip": "Closed eu: lips tight and round. Open eu: drop your jaw a little."
  },
