  "grammar": {
    "title": "aller (to go) + à",
    "intro": "aller is irregular and used everywhere. To say where you go, use à — and à changes when it meets le or les.",
    "table": [
      [
        "",
        "aller",
        "English"
      ],
      [
        "je",
        "vais",
        "I go"
      ],
      [
        "tu",
        "vas",
        "you go"
      ],
      [
        "il / elle",
        "va",
        "he / she goes"
      ],
      [
        "nous",
        "allons",
        "we go"
      ],
      [
        "vous",
        "allez",
        "you go"
      ],
      [
        "ils / elles",
        "vont",
        "they go"
      ]
    ],
    "examples": [
      {
        "fr": "Je vais à la boulangerie.",
        "en": "I'm going to the bakery."
      },
      {
        "fr": "On va au musée ?",
        "en": "Shall we go to the museum?"
      },
      {
        "fr": "Tournez à droite, puis allez tout droit.",
        "en": "Turn right, then go straight on."
      }
    ],
    "trap": "à + le = au, à + les = aux: « je vais au parc », but « à la gare », « à l'hôpital ». Never « à le ». To give directions, use the vous form without vous: « Allez tout droit ! Tournez à gauche ! »"
  },
  "sounds": {
    "title": "ch or j?",
    "explain": "The French j is not the Indonesian j. It is a soft buzzing « zh », like the s in “pleasure”. « ch » is « sh », like in “shop”.",
