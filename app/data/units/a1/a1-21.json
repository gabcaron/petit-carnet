  "grammar": {
    "title": "Feelings with avoir",
    "intro": "English says « I am hungry, I am cold, I am right ». French says « I have hunger, I have cold »: these expressions use avoir, never être.",
    "table": [
      [
        "English",
        "French",
        "Example"
      ],
      [
        "to be hungry / thirsty",
        "avoir faim / soif",
        "J'ai faim."
      ],
      [
        "to be hot / cold",
        "avoir chaud / froid",
        "Tu as froid ?"
      ],
      [
        "to be afraid of",
        "avoir peur de",
        "Elle a peur des chiens."
      ],
      [
        "to be right / wrong",
        "avoir raison / tort",
        "Tu as raison !"
      ],
      [
        "to need",
        "avoir besoin de",
        "J'ai besoin d'aide."
      ],
      [
        "to feel like",
        "avoir envie de",
        "J'ai envie d'une glace."
      ]
    ],
    "examples": [
      {
        "fr": "J'ai faim, on mange ?",
        "en": "I'm hungry, shall we eat?"
      },
      {
        "fr": "Tu as besoin d'aide ?",
        "en": "Do you need help?"
      },
      {
        "fr": "J'ai envie de dormir.",
        "en": "I feel like sleeping."
      }
    ],
    "trap": "Never « je suis faim » or « je suis chaud » (that means something rude!). Careful: « il fait chaud » is the weather, « j'ai chaud » is you. avoir besoin de / envie de can be followed by a noun or a verb: « j'ai envie d'un café », « j'ai envie de partir »."
  },
  "sounds": {
    "title": "un or une?",
    "explain": "« un » is a nasal sound (often said like « in » today). « une » loses the nasal: you hear the n clearly.",
    "pairs": [
      [
        "un",
        "une"
      ],
      [
        "aucun",
        "aucune"
      ],
      [
        "chacun",
        "chacune"
      ],
      [
        "commun",
        "commune"
      ]
    ],
    "tip": "For une, close your mouth on the n."
  },
