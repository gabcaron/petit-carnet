  "grammar": {
    "title": "ne… pas: saying no",
    "intro": "Indonesian puts one word before the verb (tidak). French wraps the verb in two words: ne + verb + pas.",
    "table": [
      [
        "Positive",
        "Negative",
        "English"
      ],
      [
        "J'aime le sport.",
        "Je n'aime pas le sport.",
        "I don't like sport."
      ],
      [
        "Je parle français.",
        "Je ne parle pas français.",
        "I don't speak French."
      ],
      [
        "Elle danse.",
        "Elle ne danse pas.",
        "She doesn't dance."
      ],
      [
        "Nous voyageons.",
        "Nous ne voyageons pas.",
        "We don't travel."
      ]
    ],
    "examples": [
      {
        "fr": "Je n'aime pas le café.",
        "en": "I don't like coffee."
      },
      {
        "fr": "Tu aimes danser ?",
        "en": "Do you like dancing?"
      },
      {
        "fr": "Il ne joue pas au tennis.",
        "en": "He doesn't play tennis."
      }
    ],
    "trap": "ne becomes n' before a vowel: « je n'aime pas ». When speaking, French people often drop the ne (« j'aime pas ») — you will hear it everywhere, but write the full form. After aimer, keep the article: « j'aime le sport », never « j'aime sport »."
  },
  "sounds": {
    "title": "an or on? Two nasal sounds",
    "explain": "Both sounds go through the nose. For « an » (also written en, em) open your mouth wide. For « on » round your lips into a small circle.",
    "pairs": [
      [
        "vent",
        "vont"
      ],
