  "grammar": {
    "title": "Verbs in -re like attendre",
    "intro": "Many useful verbs end in -re: attendre, répondre, vendre, perdre, entendre, descendre, rendre. They follow one easy pattern: no ending at all with il / elle.",
    "table": [
      [
        "",
        "attendre",
        "répondre"
      ],
      [
        "je / j'",
        "attends",
        "réponds"
      ],
      [
        "tu",
        "attends",
        "réponds"
      ],
      [
        "il / elle",
        "attend",
        "répond"
      ],
      [
        "nous",
        "attendons",
        "répondons"
      ],
      [
        "vous",
        "attendez",
        "répondez"
      ],
      [
        "ils / elles",
        "attendent",
        "répondent"
      ]
    ],
    "examples": [
      {
        "fr": "J'attends le bus.",
        "en": "I'm waiting for the bus."
      },
      {
        "fr": "Elle répond à mon message.",
        "en": "She's replying to my message."
      },
      {
        "fr": "Ils vendent leur voiture.",
        "en": "They're selling their car."
      }
    ],
    "trap": "The d is silent in attends, attend, but you hear it in the plural: « ils attendent ». attendre has no « for »: « j'attends Tom ». répondre takes à: « je réponds à Léa ». prendre is NOT like this one (nous prenons, ils prennent)."
  },
  "sounds": {
    "title": "One or several?",
    "explain": "With -re verbs, the plural is easy to hear: the d (or another consonant) is silent in the singular and pronounced in the plural.",
    "pairs": [
      [
        "il attend",
        "ils attendent"
      ],
      [
        "il répond",
        "ils répondent"
      ],
      [
        "il vend",
        "ils vendent"
      ],
      [
        "il descend",
        "ils descendent"
      ]
    ],
    "tip": "Listen for the d at the end: plural."
  },
