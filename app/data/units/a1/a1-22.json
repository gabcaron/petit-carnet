  "grammar": {
    "title": "moi, toi, lui…: stressed pronouns",
    "intro": "After a preposition (avec, pour, chez, sans…), after c'est, or to insist, French uses a special set of pronouns: moi, toi, lui, elle, nous, vous, eux, elles.",
    "table": [
      [
        "Subject",
        "Stressed",
        "Example"
      ],
      [
        "je",
        "moi",
        "Moi, je suis indonésienne."
      ],
      [
        "tu",
        "toi",
        "C'est pour toi."
      ],
      [
        "il / elle",
        "lui / elle",
        "Je pars avec lui."
      ],
      [
        "nous",
        "nous",
        "Viens chez nous !"
      ],
      [
        "vous",
        "vous",
        "C'est à vous ?"
      ],
      [
        "ils / elles",
        "eux / elles",
        "Je mange sans eux."
      ]
    ],
    "examples": [
      {
        "fr": "C'est pour moi et mon copain.",
        "en": "It's for me and my boyfriend."
      },
      {
        "fr": "Lui, il arrive demain.",
        "en": "He (as for him) arrives tomorrow."
      },
      {
        "fr": "Tu viens avec moi ?",
        "en": "Are you coming with me?"
      }
    ],
    "trap": "Never « avec je » or « pour il »: after a preposition, always moi, toi, lui… They are also used alone: « Et toi ? — Moi aussi ! ». « chez moi » = at my place / at home, « chez toi » = at your place."
  },
  "sounds": {
    "title": "ch or s?",
    "explain": "« ch » is « sh ». « s » is a simple hissing sound. Don't mix them: « chat » (cat) is not « sa » (his / her).",
