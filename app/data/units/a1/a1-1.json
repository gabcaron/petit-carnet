  "grammar": {
    "title": "être (to be) + nationality",
    "intro": "In Indonesian you say « Saya orang Indonesia » with no verb. French always needs the verb être, and the nationality changes for a woman.",
    "table": [
      [
        "",
        "être",
        "English"
      ],
      [
