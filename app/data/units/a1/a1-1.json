        "you are (friend)"
      ],
      [
        "il / elle",
        "est",
        "he / she is"
      ],
      [
        "nous",
        "sommes",
        "we are"
      ],
      [
        "vous",
        "êtes",
        "you are (polite or plural)"
      ],
      [
        "ils / elles",
        "sont",
        "they are"
      ]
    ],
    "examples": [
      {
        "fr": "Je suis indonésienne.",
        "en": "I'm Indonesian (woman)."
      },
      {
        "fr": "Il est français. Elle est française.",
        "en": "He is French. She is French."
      },
      {
        "fr": "Tu es anglaise ?",
        "en": "Are you English? (to a woman)"
      }
    ],
    "trap": "No article before a nationality: « Je suis indonésienne », never « Je suis une indonésienne ». And no capital letter: « française », but « la France »."
  },
