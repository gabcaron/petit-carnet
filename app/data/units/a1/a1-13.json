  "grammar": {
    "title": "How often? toujours, souvent, ne… jamais",
    "intro": "Frequency words usually go right after the verb. jamais works like pas: ne + verb + jamais.",
    "table": [
      [
        "English",
        "French",
        "Example"
      ],
      [
        "always",
        "toujours",
        "Je prends toujours un dessert."
      ],
      [
        "often",
        "souvent",
        "Je mange souvent du poisson."
      ],
      [
        "sometimes",
        "parfois",
        "Il boit parfois du vin."
      ],
      [
        "rarely",
        "rarement",
        "Nous sortons rarement le soir."
      ],
      [
        "never",
        "ne… jamais",
        "Je ne mange jamais de viande."
      ]
    ],
    "examples": [
      {
        "fr": "Je ne bois jamais de café le soir.",
        "en": "I never drink coffee in the evening."
      },
      {
        "fr": "Tu prends souvent un dessert ?",
        "en": "Do you often have a dessert?"
      },
      {
        "fr": "Tu n'aimes pas le fromage ? — Si, j'adore !",
        "en": "Don't you like cheese? — Yes, I love it!"
      }
    ],
    "trap": "After ne… jamais, du / de la / des become de, like after pas: « je ne mange jamais de viande ». To answer « yes » to a negative question, say si, not oui: « Tu ne viens pas ? — Si ! »."
  },
  "sounds": {
    "title": "o or o?",
    "explain": "French has a closed o (beau, pot, saule — lips very round) and an open o (porte, bol, sol — mouth more open).",
