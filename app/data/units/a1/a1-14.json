  "grammar": {
    "title": "venir de + infinitive: what just happened",
    "intro": "To say something has just happened, French uses venir (present) + de + infinitive. It is a past, but very recent — like English « I have just… ».",
    "table": [
      [
        "",
        "venir",
        "+ de + infinitive"
      ],
      [
        "je",
        "viens",
        "d'arriver"
      ],
      [
        "tu",
        "viens",
        "de manger"
      ],
      [
        "il / elle",
        "vient",
        "de partir"
      ],
      [
        "nous",
        "venons",
        "de finir"
      ],
      [
        "vous",
        "venez",
        "d'acheter"
      ],
      [
        "ils / elles",
        "viennent",
        "de sortir"
      ]
    ],
    "examples": [
      {
        "fr": "Le bus vient de partir.",
        "en": "The bus has just left."
      },
      {
        "fr": "Je viens d'arriver à Paris.",
        "en": "I've just arrived in Paris."
      },
      {
        "fr": "Nous venons de manger.",
        "en": "We've just eaten."
      }
    ],
    "trap": "de becomes d' before a vowel: « je viens d'arriver ». Don't confuse with venir de + place, which means to come from: « je viens de Bali ». Transport: en voiture, en bus, en métro, en train — but à pied, à vélo, à moto."
  },
  "sounds": {
    "title": "b or v?",
    "explain": "Indonesian sometimes mixes b, v and f. In French, b closes both lips; v puts your top teeth on your bottom lip.",
    "pairs": [
      [
        "bas",
        "va"
      ],
      [
        "boire",
        "voir"
      ],
      [
        "bain",
        "vin"
      ],
      [
        "bol",
        "vol"
      ]
    ],
    "tip": "For v, bite your bottom lip gently and make it buzz."
  },
