  "dialogue": [
    {
      "who": "Sari",
      "fr": "Excusez-moi, le bus pour la gare, il est déjà passé ?",
      "en": "Excuse me, has the bus to the station already come?"
    },
    {
      "who": "Un homme",
      "fr": "Oui, il vient de partir, désolé !",
      "en": "Yes, it has just left, sorry!"
    },
    {
      "who": "Sari",
      "fr": "Oh non ! Le prochain est à quelle heure ?",
      "en": "Oh no! What time is the next one?"
    },
    {
      "who": "Un homme",
      "fr": "Dans vingt minutes. Sinon, prenez le métro, ligne 4. C'est plus rapide.",
      "en": "In twenty minutes. Otherwise, take the metro, line 4. It's faster."
    },
    {
      "who": "Sari",
      "fr": "Je dois acheter un ticket ?",
      "en": "Do I need to buy a ticket?"
    },
    {
      "who": "Un homme",
      "fr": "Oui, au guichet ou au distributeur. Vous venez d'arriver à Paris ?",
      "en": "Yes, at the ticket office or the machine. Have you just arrived in Paris?"
    }
