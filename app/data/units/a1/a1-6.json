  "grammar": {
    "title": "du, de la, des: some",
    "intro": "When you talk about an amount you can't count — some bread, some water — French uses du, de la or des. English and Indonesian often use nothing at all.",
    "table": [
      [
        "",
        "Article",
        "Example"
      ],
      [
        "masculine",
        "du",
        "du pain, du fromage"
      ],
      [
        "feminine",
        "de la",
        "de la viande"
      ],
      [
        "before a vowel",
        "de l'",
        "de l'eau"
      ],
      [
        "plural",
        "des",
        "des fruits, des légumes"
      ],
      [
        "after a negative or a quantity",
        "de / d'",
        "pas de pain, un kilo de pommes"
      ]
    ],
    "examples": [
      {
        "fr": "Je voudrais du pain, s'il vous plaît.",
        "en": "I'd like some bread, please."
      },
      {
        "fr": "Je prends de la viande et des légumes.",
        "en": "I'll have meat and vegetables."
      },
      {
        "fr": "Je ne mange pas de poisson.",
        "en": "I don't eat fish."
      }
    ],
    "trap": "After a negative or a quantity, everything becomes de: « je ne mange pas de viande », « un kilo de pommes ». But after aimer, adorer, détester use le / la / les: « j'aime le fromage »."
  },
  "sounds": {
    "title": "eu or é?",
    "explain": "« deux » (two) and « des » (some) are different sounds. For « eu », round your lips as if to say “o”, then say “e”. For « é », smile.",
