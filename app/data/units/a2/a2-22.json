  "grammar": {
    "title": "Reciprocal verbs: se rencontrer, s'aimer",
    "intro": "Many verbs become « each other » verbs with se: ils se voient = they see each other. In the passé composé they use être, like all reflexive verbs.",
    "table": [
      [
        "",
        "Present",
        "Passé composé"
      ],
      [
        "nous",
        "nous nous aimons",
        "nous nous sommes rencontrés"
      ],
      [
        "on (= nous)",
        "on s'aime",
        "on s'est rencontrés"
      ],
      [
        "vous",
        "vous vous disputez",
        "vous vous êtes disputés"
      ],
      [
        "ils / elles",
        "ils se voient",
        "ils se sont vus"
      ]
    ],
    "examples": [
      {
        "fr": "On s'est rencontrés à Bali.",
        "en": "We met in Bali."
      },
      {
        "fr": "Ils se disputent souvent.",
        "en": "They argue often."
      },
      {
        "fr": "Vous vous êtes revus quand ?",
        "en": "When did you see each other again?"
      }
    ],
    "trap": "With être, the participle usually agrees (rencontrés, vus). Exception: verbs with à, like se parler, s'écrire, se téléphoner — no agreement: « elles se sont parlé », « on s'est écrit ». Don't worry too much about it at A2 — focus on using être."
  },
  "sounds": {
    "title": "Each other or not?",
    "explain": "The extra se (or nous / vous) changes the meaning: « ils voient » (they see), « ils se voient » (they see each other).",
    "pairs": [
      [
        "ils se voient",
        "ils voient"
      ],
      [
        "on s'aime",
        "on aime"
      ],
      [
        "ils se parlent",
        "ils parlent"
      ],
      [
        "nous nous écrivons",
        "nous écrivons"
      ]
    ],
    "tip": "Listen for the little se, s' or the double nous."
  },
