  "grammar": {
    "title": "Verb + à / de + infinitive",
    "intro": "When two verbs follow each other, some verbs need à or de before the second one. There's no logic: learn the verb with its little word, like a block.",
    "table": [
      [
        "+ de",
        "+ à",
        "no preposition"
      ],
      [
        "arrêter de",
        "commencer à",
        "aimer"
      ],
      [
        "décider de",
        "apprendre à",
        "vouloir"
      ],
      [
        "essayer de",
        "arriver à",
        "pouvoir"
      ],
      [
        "oublier de",
        "continuer à",
        "devoir"
      ],
      [
        "avoir besoin de",
        "aider qqn à",
        "aller"
      ]
    ],
    "examples": [
      {
        "fr": "J'ai arrêté de fumer.",
        "en": "I've stopped smoking."
      },
      {
        "fr": "Elle apprend à conduire.",
        "en": "She's learning to drive."
      },
      {
        "fr": "N'oublie pas d'appeler ta mère !",
        "en": "Don't forget to call your mother!"
      }
    ],
    "trap": "de becomes d' before a vowel: « essayer d'arrêter ». The second verb is always in the infinitive. aimer, vouloir, pouvoir, devoir, aller need nothing: « j'aime courir ». penser à = remember to: « pense à acheter du pain »."
  },
  "sounds": {
    "title": "in or è?",
    "explain": "Nasal « in » (fin, main, vin) vs. oral « è » (fait, mais, vais): the air goes through the nose for in.",
    "pairs": [
      [
        "fin",
        "fait"
      ],
      [
        "main",
        "mais"
      ],
      [
        "vin",
        "vais"
      ],
      [
        "pain",
        "paix"
      ]
    ],
    "tip": "Pinch your nose: in changes, è doesn't."
  },
