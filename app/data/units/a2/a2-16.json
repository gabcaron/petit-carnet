  "grammar": {
    "title": "Obligation and prohibition",
    "intro": "To say what you must or mustn't do, French has several structures, from strong to soft.",
    "table": [
      [
        "Meaning",
        "Structure",
        "Example"
      ],
      [
        "must (general)",
        "il faut + infinitive",
        "Il faut trier les déchets."
      ],
      [
        "must (person)",
        "devoir + infinitive",
        "On doit recycler."
      ],
      [
        "have to (no choice)",
        "être obligé(e) de + inf.",
        "Je suis obligée de prendre l'avion."
      ],
      [
        "should (advice)",
        "il faudrait / tu devrais + inf.",
        "Tu devrais éteindre la lumière."
      ],
      [
        "mustn't",
        "il ne faut pas + infinitive",
        "Il ne faut pas gaspiller."
      ],
      [
        "forbidden",
        "il est interdit de + infinitive",
        "Il est interdit de fumer."
      ]
    ],
    "examples": [
      {
        "fr": "Il faut économiser l'énergie.",
        "en": "We need to save energy."
      },
      {
        "fr": "Il est interdit de jeter du plastique ici.",
        "en": "It's forbidden to throw plastic here."
      },
      {
        "fr": "Tu devrais prendre le vélo.",
        "en": "You should take the bike."
      }
    ],
    "trap": "« il ne faut pas » means you mustn't (forbidden), not « you don't have to ». For « you don't have to », say « ce n'est pas obligatoire » or « tu n'es pas obligé de ». il faudrait and tu devrais are softer: polite advice."
  },
