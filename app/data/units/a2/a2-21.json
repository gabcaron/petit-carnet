  "grammar": {
    "title": "c'est or il / elle est?",
    "intro": "Both mean « he / she / it is ». The rule depends on what follows: a determiner (un, le, mon…) needs c'est; an adjective alone or a job alone takes il / elle est.",
    "table": [
      [
        "Followed by",
        "Use",
        "Example"
      ],
      [
        "un / une / le / mon… + noun",
        "c'est / ce sont",
        "C'est un homme exigeant."
      ],
      [
        "a name or stressed pronoun",
        "c'est",
        "C'est Léa. C'est moi."
      ],
      [
        "a job alone (no article)",
        "il / elle est",
        "Elle est infirmière."
      ],
      [
        "an adjective about a person",
        "il / elle est",
        "Il est exigeant."
      ],
      [
        "an adjective about a situation",
        "c'est",
        "C'est difficile !"
      ]
    ],
    "examples": [
      {
        "fr": "Elle est infirmière. C'est une bonne infirmière.",
        "en": "She's a nurse. She's a good nurse."
      },
      {
        "fr": "C'est une clinique connue.",
        "en": "It's a well-known clinic."
      },
      {
        "fr": "Le travail de nuit ? C'est fatigant !",
        "en": "Night work? It's tiring!"
      }
    ],
    "trap": "Never « il est un homme »: with un / une, always c'est. Never « c'est infirmière »: a job alone takes il / elle est. For something general or a whole situation: « c'est beau, c'est cher, c'est génial »."
  },
  "sounds": {
    "title": "c'est or il est?",
    "explain": "Train your ear: « c'est » starts with an s sound, « il est » with an il, and « ce sont » with an s too.",
    "pairs": [
      [
        "c'est",
        "il est"
      ],
      [
        "c'est un prof",
        "il est prof"
      ],
      [
        "elle est",
        "c'est elle"
      ],
      [
        "ils sont",
        "ce sont"
      ]
    ],
    "tip": "Listen to the first sound: s = c'est, i = il est."
  },
