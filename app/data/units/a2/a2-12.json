  "grammar": {
    "title": "Quel… ! Que… ! Comme… !: exclamations",
    "intro": "To react with emotion — surprise, joy, pity — French uses quel + noun, or que / comme + a whole sentence.",
    "table": [
      [
        "Structure",
        "Use",
        "Example"
      ],
      [
        "Quel / Quelle + noun !",
        "with a noun",
        "Quelle surprise ! Quel beau temps !"
      ],
      [
        "Quels / Quelles + noun !",
        "plural",
        "Quelles jolies photos !"
      ],
      [
        "Que + sentence !",
        "how… !",
        "Qu'il est petit !"
      ],
      [
        "Comme + sentence !",
        "how… ! (very common)",
        "Comme je suis contente !"
      ],
      [
        "Ce que + sentence !",
        "how… ! (spoken)",
        "Ce qu'il fait chaud !"
      ]
    ],
    "examples": [
      {
        "fr": "Quelle bonne nouvelle !",
        "en": "What great news!"
      },
      {
        "fr": "Comme il est mignon !",
        "en": "He's so cute!"
      },
      {
        "fr": "Quel dommage !",
        "en": "What a pity!"
      }
    ],
    "trap": "quel agrees with the noun like in questions: quel, quelle, quels, quelles — all pronounced the same. Don't confuse « comme » (how…!) with « comment » (how? in a question). que becomes qu' before a vowel: « Qu'il est grand ! »."
  },
  "sounds": {
    "title": "Question or exclamation?",
    "explain": "The same words can be a question (voice up at the end) or an exclamation (voice up, then strongly down). And « comme » is not « comment ».",
    "pairs": [
      [
        "comme",
        "comment"
      ],
      [
        "Quelle robe ?",
        "Quelle belle robe !"
      ],
      [
        "Que c'est beau !",
        "Qu'est-ce que c'est ?"
      ],
      [
        "Ah bon ?",
        "Ah bon !"
      ]
    ],
    "tip": "Exclamation: say it with a big smile and a falling voice."
  },
