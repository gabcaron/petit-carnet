  "grammar": {
    "title": "Past tense with être",
    "intro": "In A1 you saw that a few verbs use être in the past. At A2 you learn the whole list: movement verbs (aller, venir, partir, arriver, monter, descendre…) and all reflexive verbs (se lever, se promener…). With être, the participle agrees like an adjective.",
    "table": [
      [
        "",
        "partir (past)",
        "English"
      ],
      [
        "je",
        "suis parti(e)",
        "I left"
      ],
      [
        "tu",
        "es parti(e)",
        "you left"
      ],
      [
        "il / elle",
        "est parti / partie",
        "he / she left"
      ],
      [
        "nous",
        "sommes partis / parties",
        "we left"
      ],
      [
        "vous",
        "êtes parti(e)(s)",
        "you left"
      ],
      [
        "ils / elles",
        "sont partis / parties",
        "they left"
      ]
    ],
    "examples": [
      {
        "fr": "Elle est arrivée à Paris en 2024.",
        "en": "She arrived in Paris in 2024."
      },
      {
        "fr": "Nous sommes sortis vers minuit.",
        "en": "We went out around midnight."
      },
      {
        "fr": "Je me suis levée tôt ce matin.",
        "en": "I got up early this morning. (woman)"
      }
    ],
    "trap": "Add -e for a woman and -s for a plural: « elle est partie », « ils sont partis », « elles sont parties ». A mixed group takes -s only. Reflexive verbs work the same: « je me suis promenée ». Never « j'ai allé »."
  },
  "sounds": {
    "title": "s or z?",
    "explain": "One s between two vowels sounds like z. Two s (ss) sound like s. It changes the meaning: « poisson » is fish, « poison » is poison!",
    "pairs": [
      [
        "poisson",
        "poison"
      ],
      [
        "dessert",
        "désert"
      ],
      [
        "coussin",
        "cousin"
      ],
      [
        "basse",
        "base"
      ]
    ],
    "tip": "Put your hand on your throat: for z you feel it buzz, for s you don't."
  },
