  "grammar": {
    "title": "mon, ma, mes: possessives",
    "intro": "In Indonesian, « ibu saya » works for everything. In French the possessive agrees with the thing you own, not with you: « mon père », « ma mère », « mes parents ».",
    "table": [
      [
        "masculine",
        "feminine",
        "plural",
        "English"
      ],
      [
        "mon",
        "ma",
        "mes",
        "my"
      ],
      [
        "ton",
        "ta",
        "tes",
        "your (friend)"
      ],
      [
        "son",
        "sa",
        "ses",
        "his / her"
      ]
    ],
    "examples": [
      {
        "fr": "Voici mon père et ma mère.",
        "en": "Here are my father and my mother."
      },
      {
        "fr": "Ce sont mes parents.",
        "en": "These are my parents."
      },
      {
        "fr": "Sa sœur est très gentille.",
        "en": "His (or her) sister is very kind."
      }
    ],
    "trap": "« son » and « sa » mean both his and her — it depends on the noun: « sa mère » = his mother OR her mother. Before a vowel, use mon / ton / son even for a feminine word: « mon amie »."
  },
  "sounds": {
    "title": "le or les? Hearing the plural",
    "explain": "The final s of a plural is silent: « frère » and « frères » sound the same. You hear the plural in the little word before: le (luh) → les (lay), mon → mes.",
    "pairs": [
      [
        "le frère",
        "les frères"
      ],
      [
        "mon frère",
        "mes frères"
      ],
      [
        "ta sœur",
        "tes sœurs"
      ],
      [
        "la fille",
        "les filles"
      ]
    ],
    "tip": "Smile for « les » and « mes » (like \"ay\"), round your lips for « le »."
  },
