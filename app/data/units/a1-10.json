        "avons pris",
        "we took"
      ],
      [
        "vous",
        "avez bu",
        "you drank"
      ],
      [
        "ils / elles",
        "ont dormi",
        "they slept"
      ]
    ],
    "examples": [
      {
        "fr": "Hier, j'ai mangé au restaurant.",
        "en": "Yesterday I ate at a restaurant."
      },
      {
        "fr": "Elle est partie ce matin.",
        "en": "She left this morning."
